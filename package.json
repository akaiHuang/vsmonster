{
  "name": "vsmonster",
  "version": "0.2.0",
  "private": true,
  "description": "VSMONSTER 👾 - 將社群軟體連接到 VS Code Copilot (Powered by 🦞 Moltbot)",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm run dev:all",
    "dev:gateway": "pnpm --filter @vsmonster/gateway dev",
    "dev:mission": "pnpm --filter @vsmonster/mission-control dev",
    "dev:all": "concurrently \"pnpm dev:gateway\" \"pnpm dev:mission\"",
    "start": "pnpm --filter @vsmonster/gateway start",
    "start:mission": "pnpm --filter @vsmonster/mission-control start",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @vsmonster/mission-control test:e2e",
    "test:e2e:ui": "pnpm --filter @vsmonster/mission-control test:e2e:ui",
    "typecheck": "pnpm -r type-check",
    "extension:build": "pnpm --filter vsmonster build",
    "extension:watch": "pnpm --filter vsmonster watch",
    "postinstall": "node scripts/post-install.js",
    "ci": "pnpm install && pnpm typecheck && pnpm build && pnpm test"
  },
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.x"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0"
}
