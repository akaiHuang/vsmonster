{
  "name": "vsmonster",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.0.1",
  "publisher": "vsmonster",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/akaiHuang/vsmonster"
  },
  "homepage": "https://github.com/akaiHuang/vsmonster#readme",
  "bugs": {
    "url": "https://github.com/akaiHuang/vsmonster/issues"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Machine Learning",
    "Chat"
  ],
  "keywords": [
    "copilot",
    "line",
    "telegram",
    "discord",
    "chat",
    "ai",
    "mcp",
    "task",
    "automation"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "commands": [
      {
        "command": "vsmonster.connect",
        "title": "%command.connect%",
        "category": "VSMONSTER"
      },
      {
        "command": "vsmonster.disconnect",
        "title": "%command.disconnect%",
        "category": "VSMONSTER"
      },
      {
        "command": "vsmonster.showStatus",
        "title": "%command.showStatus%",
        "category": "VSMONSTER"
      },
      {
        "command": "vsmonster.startGateway",
        "title": "%command.startGateway%",
        "category": "VSMONSTER"
      },
      {
        "command": "vsmonster.openSettings",
        "title": "%command.openSettings%",
        "category": "VSMONSTER"
      },
      {
        "command": "vsmonster.sendToChannel",
        "title": "%command.sendToChannel%",
        "category": "VSMONSTER"
      },
      {
        "command": "vsmonster.refreshTasks",
        "title": "%command.refreshTasks%",
        "category": "VSMONSTER",
        "icon": "$(refresh)"
      },
      {
        "command": "vsmonster.runSetupWizard",
        "title": "%command.runSetupWizard%",
        "category": "VSMONSTER"
      },
      {
        "command": "vsmonster.openQuickStart",
        "title": "%command.openQuickStart%",
        "category": "VSMONSTER"
      },
      {
        "command": "vsmonster.switchLanguage",
        "title": "%command.switchLanguage%",
        "category": "VSMONSTER"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vsmonster",
          "title": "VSMONSTER",
          "icon": "resources/icon.png"
        }
      ]
    },
    "views": {
      "vsmonster": [
        {
          "id": "vsmonsterTasks",
          "name": "%view.tasks%",
          "contextualTitle": "%view.tasks.context%"
        },
        {
          "id": "vsmonsterChannels",
          "name": "%view.channels%",
          "contextualTitle": "%view.channels.context%"
        },
        {
          "id": "vsmonsterMCP",
          "name": "%view.mcp%",
          "contextualTitle": "%view.mcp.context%"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "vsmonster.refreshTasks",
          "when": "view == vsmonsterTasks",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "VSMONSTER",
      "properties": {
        "vsmonster.gatewayUrl": {
          "type": "string",
          "default": "ws://localhost:3000",
          "description": "%config.gatewayUrl%"
        },
        "vsmonster.autoConnect": {
          "type": "boolean",
          "default": true,
          "description": "%config.autoConnect%"
        },
        "vsmonster.showNotifications": {
          "type": "boolean",
          "default": true,
          "description": "%config.showNotifications%"
        },
        "vsmonster.defaultModel": {
          "type": "string",
          "default": "gpt-4",
          "enum": [
            "gpt-4",
            "gpt-4-turbo",
            "gpt-3.5-turbo",
            "claude-3-opus",
            "claude-3-sonnet"
          ],
          "description": "%config.defaultModel%"
        },
        "vsmonster.language": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "en",
            "zh-TW",
            "zh-CN",
            "ja",
            "de",
            "fr",
            "ru"
          ],
          "enumDescriptions": [
            "Auto-detect from VS Code language",
            "English",
            "繁體中文",
            "简体中文",
            "日本語",
            "Deutsch",
            "Français",
            "Русский"
          ],
          "description": "%config.language.description%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "node esbuild.js --production",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/node": "^20.x",
    "@types/vscode": "^1.85.0",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^6.x",
    "@typescript-eslint/parser": "^6.x",
    "esbuild": "^0.20.0",
    "eslint": "^8.x",
    "typescript": "^5.x"
  },
  "dependencies": {
    "ws": "8.19.0"
  }
}
