{
  "name": "vsmonster",
  "displayName": "VSMONSTER - Copilot 社群整合",
  "description": "將 LINE、Telegram 等社群軟體連接到 VS Code Copilot",
  "version": "0.0.1",
  "publisher": "vsmonster",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Machine Learning",
    "Chat"
  ],
  "keywords": [
    "copilot",
    "line",
    "telegram",
    "discord",
    "chat",
    "ai",
    "mcp"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vsmonster.connect",
        "title": "連接 Gateway",
        "category": "VSMONSTER"
      },
      {
        "command": "vsmonster.disconnect",
        "title": "斷開連接",
        "category": "VSMONSTER"
      },
      {
        "command": "vsmonster.showStatus",
        "title": "顯示狀態",
        "category": "VSMONSTER"
      },
      {
        "command": "vsmonster.startGateway",
        "title": "啟動 Gateway",
        "category": "VSMONSTER"
      },
      {
        "command": "vsmonster.openSettings",
        "title": "開啟設定",
        "category": "VSMONSTER"
      },
      {
        "command": "vsmonster.sendToChannel",
        "title": "發送訊息到頻道",
        "category": "VSMONSTER"
      },
      {
        "command": "vsmonster.refreshTasks",
        "title": "刷新任務列表",
        "category": "VSMONSTER",
        "icon": "$(refresh)"
      },
      {
        "command": "vsmonster.runSetupWizard",
        "title": "執行設定向導",
        "category": "VSMONSTER"
      },
      {
        "command": "vsmonster.openQuickStart",
        "title": "開啟快速開始指南",
        "category": "VSMONSTER"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vsmonster",
          "title": "VSMONSTER",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "vsmonster": [
        {
          "id": "vsmonsterTasks",
          "name": "任務列表",
          "contextualTitle": "VSMONSTER 任務"
        },
        {
          "id": "vsmonsterChannels",
          "name": "頻道狀態",
          "contextualTitle": "社群頻道"
        },
        {
          "id": "vsmonsterMCP",
          "name": "MCP 服務",
          "contextualTitle": "MCP 服務器"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "vsmonster.refreshTasks",
          "when": "view == vsmonsterTasks",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "VSMONSTER",
      "properties": {
        "vsmonster.gatewayUrl": {
          "type": "string",
          "default": "ws://localhost:3000",
          "description": "Gateway WebSocket URL"
        },
        "vsmonster.autoConnect": {
          "type": "boolean",
          "default": true,
          "description": "VS Code 啟動時自動連接 Gateway"
        },
        "vsmonster.showNotifications": {
          "type": "boolean",
          "default": true,
          "description": "顯示任務通知"
        },
        "vsmonster.defaultModel": {
          "type": "string",
          "default": "gpt-4",
          "enum": [
            "gpt-4",
            "gpt-4-turbo",
            "gpt-3.5-turbo",
            "claude-3-opus",
            "claude-3-sonnet"
          ],
          "description": "預設 AI 模型"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/node": "^20.x",
    "@types/vscode": "^1.85.0",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^6.x",
    "@typescript-eslint/parser": "^6.x",
    "eslint": "^8.x",
    "typescript": "^5.x"
  },
  "dependencies": {
    "ws": "^8.16.0"
  }
}
