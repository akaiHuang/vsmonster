{
  "name": "vsmonster",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.0.2",
  "publisher": "vsmonster",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/akaiHuang/vsmonster"
  },
  "homepage": "https://github.com/akaiHuang/vsmonster#readme",
  "bugs": {
    "url": "https://github.com/akaiHuang/vsmonster/issues"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Machine Learning",
    "Chat"
  ],
  "keywords": [
    "line",
    "telegram",
    "discord",
    "chat",
    "ai",
    "mcp",
    "task",
    "automation"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "commands": [
      {
        "command": "vsmonster.connect",
        "title": "%command.connect%",
        "category": "VSMONSTER"
      },
      {
        "command": "vsmonster.disconnect",
        "title": "%command.disconnect%",
        "category": "VSMONSTER"
      },
      {
        "command": "vsmonster.showStatus",
        "title": "%command.showStatus%",
        "category": "VSMONSTER"
      },
      {
        "command": "vsmonster.startGateway",
        "title": "%command.startGateway%",
        "category": "VSMONSTER"
      },
      {
        "command": "vsmonster.openSettings",
        "title": "%command.openSettings%",
        "category": "VSMONSTER",
        "icon": "$(gear)"
      },
      {
        "command": "vsmonster.setPrimaryWindow",
        "title": "%command.setPrimaryWindow%",
        "category": "VSMONSTER",
        "icon": "$(pin)"
      },
      {
        "command": "vsmonster.sendToChannel",
        "title": "%command.sendToChannel%",
        "category": "VSMONSTER"
      },
      {
        "command": "vsmonster.refreshTasks",
        "title": "%command.refreshTasks%",
        "category": "VSMONSTER",
        "icon": "$(refresh)"
      },
      {
        "command": "vsmonster.runSetupWizard",
        "title": "%command.runSetupWizard%",
        "category": "VSMONSTER"
      },
      {
        "command": "vsmonster.openQuickStart",
        "title": "%command.openQuickStart%",
        "category": "VSMONSTER"
      },
      {
        "command": "vsmonster.switchLanguage",
        "title": "%command.switchLanguage%",
        "category": "VSMONSTER"
      },
      {
        "command": "vsmonster.selectModel",
        "title": "%command.selectModel%",
        "category": "VSMONSTER",
        "icon": "$(hubot)"
      },
      {
        "command": "vsmonster.openChatPanel",
        "title": "%command.openChatPanel%",
        "category": "VSMONSTER",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "vsmonster.refreshChannels",
        "title": "%command.refreshChannels%",
        "category": "VSMONSTER",
        "icon": "$(refresh)"
      },
      {
        "command": "vsmonster.refreshMCP",
        "title": "%command.refreshMCP%",
        "category": "VSMONSTER",
        "icon": "$(refresh)"
      },
      {
        "command": "vsmonster.sendToCopilot",
        "title": "%command.sendToCopilot%",
        "category": "VSMONSTER",
        "icon": "$(hubot)"
      },
      {
        "command": "vsmonster.sendToLine",
        "title": "%command.sendToLine%",
        "category": "VSMONSTER",
        "icon": "$(comment)"
      },
      {
        "command": "vsmonster.sendToTelegram",
        "title": "%command.sendToTelegram%",
        "category": "VSMONSTER",
        "icon": "$(send)"
      },
      {
        "command": "vsmonster.sendToDiscord",
        "title": "%command.sendToDiscord%",
        "category": "VSMONSTER",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "vsmonster.clearChat",
        "title": "%command.clearChat%",
        "category": "VSMONSTER",
        "icon": "$(clear-all)"
      },
      {
        "command": "vsmonster.copyMessage",
        "title": "%command.copyMessage%",
        "category": "VSMONSTER"
      },
      {
        "command": "vsmonster.clearTasks",
        "title": "%command.clearTasks%",
        "category": "VSMONSTER",
        "icon": "$(trash)"
      },
      {
        "command": "vsmonster.connect",
        "title": "%command.connect%",
        "category": "VSMONSTER",
        "icon": "$(plug)"
      },
      {
        "command": "vsmonster.disconnect",
        "title": "%command.disconnect%",
        "category": "VSMONSTER",
        "icon": "$(debug-disconnect)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vsmonster",
          "title": "VSMONSTER",
          "icon": "resources/icon.png"
        }
      ]
    },
    "views": {
      "vsmonster": [
        {
          "id": "vsmonsterTasks",
          "name": "%view.tasks%",
          "contextualTitle": "%view.tasks.context%"
        },
        {
          "id": "vsmonsterChat",
          "name": "%view.chat%",
          "contextualTitle": "%view.chat.context%"
        },
        {
          "id": "vsmonsterChannels",
          "name": "%view.channels%",
          "contextualTitle": "%view.channels.context%"
        },
        {
          "id": "vsmonsterMCP",
          "name": "%view.mcp%",
          "contextualTitle": "%view.mcp.context%"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "vsmonster.connect",
          "when": "view == vsmonsterTasks && !vsmonster.connected",
          "group": "navigation@1"
        },
        {
          "command": "vsmonster.disconnect",
          "when": "view == vsmonsterTasks && vsmonster.connected",
          "group": "navigation@1"
        },
        {
          "command": "vsmonster.selectModel",
          "when": "view == vsmonsterTasks",
          "group": "navigation@2"
        },
        {
          "command": "vsmonster.refreshTasks",
          "when": "view == vsmonsterTasks",
          "group": "navigation@3"
        },
        {
          "command": "vsmonster.clearTasks",
          "when": "view == vsmonsterTasks",
          "group": "navigation@4"
        },
        {
          "command": "vsmonster.openSettings",
          "when": "view == vsmonsterTasks",
          "group": "navigation@5"
        },
        {
          "command": "vsmonster.sendToCopilot",
          "when": "view == vsmonsterChat",
          "group": "navigation@1"
        },
        {
          "command": "vsmonster.sendToLine",
          "when": "view == vsmonsterChat",
          "group": "navigation@2"
        },
        {
          "command": "vsmonster.sendToTelegram",
          "when": "view == vsmonsterChat",
          "group": "navigation@3"
        },
        {
          "command": "vsmonster.sendToDiscord",
          "when": "view == vsmonsterChat",
          "group": "navigation@4"
        },
        {
          "command": "vsmonster.clearChat",
          "when": "view == vsmonsterChat",
          "group": "navigation@5"
        },
        {
          "command": "vsmonster.connect",
          "when": "view == vsmonsterChannels && !vsmonster.connected",
          "group": "navigation@1"
        },
        {
          "command": "vsmonster.refreshChannels",
          "when": "view == vsmonsterChannels",
          "group": "navigation@2"
        },
        {
          "command": "vsmonster.refreshMCP",
          "when": "view == vsmonsterMCP",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "VSMONSTER",
      "properties": {
        "vsmonster.gatewayUrl": {
          "type": "string",
          "default": "ws://localhost:3000",
          "description": "%config.gatewayUrl%"
        },
        "vsmonster.autoConnect": {
          "type": "boolean",
          "default": true,
          "description": "%config.autoConnect%"
        },
        "vsmonster.showNotifications": {
          "type": "boolean",
          "default": true,
          "description": "%config.showNotifications%"
        },
        "vsmonster.defaultModel": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.defaultModel.description%",
          "description": "%config.defaultModel%"
        },
        "vsmonster.copilotMode": {
          "type": "string",
          "default": "lm",
          "enum": [
            "lm",
            "chat-ui"
          ],
          "enumDescriptions": [
            "%config.copilotMode.lm%",
            "%config.copilotMode.chatUi%"
          ],
          "description": "%config.copilotMode%"
        },
        "vsmonster.language": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "en",
            "zh-TW",
            "zh-CN",
            "ja",
            "de",
            "fr",
            "ru"
          ],
          "enumDescriptions": [
            "Auto-detect from VS Code language",
            "English",
            "繁體中文",
            "简体中文",
            "日本語",
            "Deutsch",
            "Français",
            "Русский"
          ],
          "description": "%config.language.description%"
        },
        "vsmonster.channels.line.channelAccessToken": {
          "type": "string",
          "default": "",
          "description": "LINE Channel Access Token"
        },
        "vsmonster.channels.line.channelSecret": {
          "type": "string",
          "default": "",
          "description": "LINE Channel Secret"
        },
        "vsmonster.channels.line.webhookSecret": {
          "type": "string",
          "default": "",
          "description": "LINE Webhook Security Token (自動生成的隨機字串)"
        },
        "vsmonster.channels.line.whitelist": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "LINE 使用者白名單 (User IDs)"
        },
        "vsmonster.channels.telegram.botToken": {
          "type": "string",
          "default": "",
          "description": "Telegram Bot Token"
        },
        "vsmonster.channels.telegram.webhookSecret": {
          "type": "string",
          "default": "",
          "description": "Telegram Webhook Security Token"
        },
        "vsmonster.channels.telegram.whitelist": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Telegram 使用者白名單 (User IDs)"
        },
        "vsmonster.channels.discord.botToken": {
          "type": "string",
          "default": "",
          "description": "Discord Bot Token"
        },
        "vsmonster.channels.discord.applicationId": {
          "type": "string",
          "default": "",
          "description": "Discord Application ID"
        },
        "vsmonster.tunnel.cloudflare.tunnelId": {
          "type": "string",
          "default": "",
          "description": "Cloudflare Tunnel ID"
        },
        "vsmonster.tunnel.cloudflare.accountId": {
          "type": "string",
          "default": "",
          "description": "Cloudflare Account ID"
        },
        "vsmonster.tunnel.cloudflare.token": {
          "type": "string",
          "default": "",
          "description": "Cloudflare Tunnel Token"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "node esbuild.js --production",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/node": "^20.x",
    "@types/vscode": "^1.85.0",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^6.x",
    "@typescript-eslint/parser": "^6.x",
    "esbuild": "^0.20.0",
    "eslint": "^8.x",
    "typescript": "^5.x"
  },
  "dependencies": {
    "ws": "8.19.0"
  }
}
