{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VSMONSTER Configuration",
  "description": "VSMONSTER \u914d\u7f6e\u6587\u4ef6\u683c\u5f0f",
  "type": "object",
  "properties": {
    "port": {
      "type": "number",
      "default": 3000,
      "description": "Gateway \u76e3\u807d\u7aef\u53e3"
    },
    "channels": {
      "type": "object",
      "description": "\u793e\u7fa4\u983b\u9053\u914d\u7f6e",
      "properties": {
        "line": {
          "type": "object",
          "properties": {
            "channelAccessToken": {
              "type": "string",
              "description": "LINE Channel Access Token"
            },
            "channelSecret": {
              "type": "string",
              "description": "LINE Channel Secret"
            },
            "webhookSecret": {
              "type": "string",
              "description": "LINE Webhook Secret (URL path segment)"
            },
            "whitelist": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "LINE whitelist user IDs"
            }
          },
          "required": [
            "channelAccessToken",
            "channelSecret"
          ]
        },
        "telegram": {
          "type": "object",
          "properties": {
            "botToken": {
              "type": "string",
              "description": "Telegram Bot Token"
            },
            "webhookUrl": {
              "type": "string",
              "description": "Telegram Webhook URL (\u53ef\u9078)"
            }
          },
          "required": [
            "botToken"
          ]
        },
        "discord": {
          "type": "object",
          "properties": {
            "botToken": {
              "type": "string",
              "description": "Discord Bot Token"
            },
            "applicationId": {
              "type": "string",
              "description": "Discord Application ID"
            },
            "publicKey": {
              "type": "string",
              "description": "Discord Public Key"
            }
          },
          "required": [
            "botToken",
            "applicationId"
          ]
        }
      }
    },
    "tunnel": {
      "type": "object",
      "description": "ngrok \u96a7\u9053\u914d\u7f6e",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false,
          "description": "\u662f\u5426\u555f\u7528 ngrok"
        },
        "authtoken": {
          "type": "string",
          "description": "ngrok Auth Token"
        },
        "region": {
          "type": "string",
          "enum": [
            "us",
            "eu",
            "ap",
            "au",
            "sa",
            "jp",
            "in"
          ],
          "default": "ap",
          "description": "ngrok \u5340\u57df"
        },
        "subdomain": {
          "type": "string",
          "description": "ngrok \u81ea\u5b9a\u7fa9\u5b50\u57df\u540d (\u9700\u8981\u4ed8\u8cbb\u5e33\u865f)"
        }
      }
    },
    "mcp": {
      "type": "object",
      "description": "MCP \u670d\u52d9\u5668\u914d\u7f6e",
      "properties": {
        "servers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "MCP \u670d\u52d9\u5668\u540d\u7a31"
              },
              "command": {
                "type": "string",
                "description": "\u555f\u52d5\u547d\u4ee4"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "\u547d\u4ee4\u53c3\u6578"
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "\u74b0\u5883\u8b8a\u6578"
              },
              "enabled": {
                "type": "boolean",
                "default": true,
                "description": "\u662f\u5426\u555f\u7528"
              }
            },
            "required": [
              "name",
              "command"
            ]
          }
        }
      }
    },
    "publicUrl": {
      "type": "string",
      "description": "Public base URL (e.g. https://ufo.fawstudio.com)"
    }
  }
}
