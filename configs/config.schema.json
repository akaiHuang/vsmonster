{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VSMONSTER Configuration",
  "description": "VSMONSTER 配置文件格式",
  "type": "object",
  "properties": {
    "port": {
      "type": "number",
      "default": 3000,
      "description": "Gateway 監聽端口"
    },
    "channels": {
      "type": "object",
      "description": "社群頻道配置",
      "properties": {
        "line": {
          "type": "object",
          "properties": {
            "channelAccessToken": {
              "type": "string",
              "description": "LINE Channel Access Token"
            },
            "channelSecret": {
              "type": "string",
              "description": "LINE Channel Secret"
            }
          },
          "required": ["channelAccessToken", "channelSecret"]
        },
        "telegram": {
          "type": "object",
          "properties": {
            "botToken": {
              "type": "string",
              "description": "Telegram Bot Token"
            },
            "webhookUrl": {
              "type": "string",
              "description": "Telegram Webhook URL (可選)"
            }
          },
          "required": ["botToken"]
        },
        "discord": {
          "type": "object",
          "properties": {
            "botToken": {
              "type": "string",
              "description": "Discord Bot Token"
            },
            "applicationId": {
              "type": "string",
              "description": "Discord Application ID"
            },
            "publicKey": {
              "type": "string",
              "description": "Discord Public Key"
            }
          },
          "required": ["botToken", "applicationId"]
        }
      }
    },
    "tunnel": {
      "type": "object",
      "description": "ngrok 隧道配置",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false,
          "description": "是否啟用 ngrok"
        },
        "authtoken": {
          "type": "string",
          "description": "ngrok Auth Token"
        },
        "region": {
          "type": "string",
          "enum": ["us", "eu", "ap", "au", "sa", "jp", "in"],
          "default": "ap",
          "description": "ngrok 區域"
        },
        "subdomain": {
          "type": "string",
          "description": "ngrok 自定義子域名 (需要付費帳號)"
        }
      }
    },
    "mcp": {
      "type": "object",
      "description": "MCP 服務器配置",
      "properties": {
        "servers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "MCP 服務器名稱"
              },
              "command": {
                "type": "string",
                "description": "啟動命令"
              },
              "args": {
                "type": "array",
                "items": { "type": "string" },
                "description": "命令參數"
              },
              "env": {
                "type": "object",
                "additionalProperties": { "type": "string" },
                "description": "環境變數"
              },
              "enabled": {
                "type": "boolean",
                "default": true,
                "description": "是否啟用"
              }
            },
            "required": ["name", "command"]
          }
        }
      }
    }
  }
}
